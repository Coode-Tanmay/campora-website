# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Canonical public origin of the deployed CAMPORA website (no trailing slash).
# Must exactly match the OAuth redirect origin used by Google/Microsoft.
APP_URL="https://campora-website.vercel.app"

# CAMPORA Administrator Authentication Secrets (role: admin)
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
JWT_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS_LONG"

# Google OAuth 2.0 Configuration for CAMPORA Customers
# Configure in Google Cloud Console (https://console.cloud.google.com/apis/credentials):
# Authorized Redirect URI: https://campora-website.vercel.app/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth 2.0 Configuration for CAMPORA Customers
# Configure in Microsoft Azure / Entra Portal (https://portal.azure.com):
# Authorized Redirect URI: https://campora-website.vercel.app/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Supabase Database Configuration
SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL"
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_KEY"

# Razorpay Standard Checkout (disabled by default; keep RAZORPAY_ENABLED=false until owner approval)
# Use TEST keys during integration testing. Never expose the key secret in frontend variables.
RAZORPAY_ENABLED=false
RAZORPAY_MODE=test
RAZORPAY_LIVE_APPROVED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Transactional email (optional; requires a sender identity verified with Resend).
# Do not use onboarding@resend.dev for customer recipients; it is for testing only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Google Apps Script HTTPS email relay
GMAIL_APPS_SCRIPT_URL=
GMAIL_APPS_SCRIPT_TOKEN=
